# Copy to `.env` (ignored by git) or export these variables before starting the services. NEVER commit real values.

# --- Control hub (k9_control_hub) ---
PORT=3080
# If set, every browser, the Android app and the REST API must send this token (?token=...). Strongly recommended on shared networks.
HUB_TOKEN=
# Optional MQTT bridge
MQTT_BROKER=mqtt://localhost:1883
MQTT_PASS=

# --- Vivo (k9_vivo) ---
# Only needed for the cloud AI. Leave empty to use local rules only (nothing leaves the PC).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
